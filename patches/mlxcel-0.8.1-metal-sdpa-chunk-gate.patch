index 794601c..f79e0b8 100644
--- a/src/lib/mlxcelverse/CMakeLists.txt
+++ b/src/lib/mlxcelverse/CMakeLists.txt
@@ -55,6 +55,7 @@ function(mlx_apply_source_overlays mlx_source_dir)
   # helper and the branch before the steel GEMM route.
   set(_metal_patch_files
       "mlx/backend/metal/device.cpp"
+      "mlx/backend/metal/kernels/CMakeLists.txt"
       "mlx/backend/metal/kernels/quantized.metal"
       "mlx/backend/metal/kernels/utils.h"

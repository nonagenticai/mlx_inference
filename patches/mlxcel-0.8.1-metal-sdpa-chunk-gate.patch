 src/lib/mlxcel-core/src/window_sdpa.rs        |  9 +++
 src/lib/mlxcelverse/CMakeLists.txt            |  1 +
 .../mlx/backend/metal/kernels/CMakeLists.txt  | 48 ++++++++++++++

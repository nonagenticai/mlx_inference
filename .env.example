# ==============================================================================
# MLX Inference Service - Configuration
# ==============================================================================
# Copy this to .env and edit. `.env` is gitignored; this example is tracked.
# The launcher (scripts/serve_rust.sh) sets sensible loopback defaults.
# ==============================================================================

# ------------------------------------------------------------------------------
# Model
# ------------------------------------------------------------------------------
# MODEL=mlx-community/AREX-2-6bit
# MLXCEL_MODEL=/path/to/snapshot   # default: resolved from the HF cache for MODEL
# DEFAULT_MODEL=mlx-community/AREX-2-6bit

# ------------------------------------------------------------------------------
# Native engine (mlxcel)
# ------------------------------------------------------------------------------
# MLXCEL_BIN=mlxcel-server         # brew install lablup/tap/mlxcel
# MLXCEL_PORT=8996                 # loopback only; never 8000
# MLXCEL_API_KEY=mlx-inference-local
# MLXCEL_READY_TIMEOUT_SECS=300    # cold 22.8 GB load
# MLXCEL_SPAWN=true                # false connects to an externally managed engine
# MLXCEL_LOG_FILE=logs/mlxcel-sidecar.log
# MLXCEL_LOG_LEVEL=info

# ------------------------------------------------------------------------------
# HTTP surface
# ------------------------------------------------------------------------------
# OPENAI_API_HOST=127.0.0.1
# OPENAI_API_PORT=8998
# AUTH_ENABLED=false               # local loopback default; true in a deployment
# API_KEY=                         # when set, /v1/* requires "Authorization: Bearer <key>"
# CORS_ALLOWED_ORIGINS=http://localhost:8998,http://127.0.0.1:8998
# LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# JWT authentication (RS256 only; used when AUTH_ENABLED=true)
# ------------------------------------------------------------------------------
# JWT_PUBLIC_KEY=                  # inline PEM
# JWT_PUBLIC_KEY_PATH=             # or a file path
# JWT_ISSUER=
# JWT_AUDIENCE=
# TRUSTED_CIDRS=127.0.0.1/32,::1/128,192.168.0.0/16,172.16.0.0/12,10.0.0.0/8

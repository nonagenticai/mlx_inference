{
  "name": "anthropic_tool_stream",
  "mode": "schema",
  "request": {
    "method": "POST",
    "path": "/v1/messages",
    "headers": {
      "anthropic-version": "2023-06-01"
    },
    "json": {
      "model": "mlx-community/AREX-2-6bit",
      "max_tokens": 128,
      "stream": true,
      "thinking": {
        "type": "disabled"
      },
      "tool_choice": {
        "type": "any"
      },
      "system": "You are a customer-care assistant. Use the tools you are given.",
      "tools": [
        {
          "name": "get_order_status",
          "description": "Look up the delivery status for a customer order.",
          "input_schema": {
            "type": "object",
            "properties": {
              "order_id": {
                "type": "string",
                "description": "The order id"
              }
            },
            "required": [
              "order_id"
            ]
          }
        }
      ],
      "messages": [
        {
          "role": "user",
          "content": "Check the delivery status of order 1234. Use the get_order_status tool."
        }
      ]
    }
  }
}
